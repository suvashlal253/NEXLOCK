<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Biometric Hardware (Phase 2 Active) -->
    <uses-permission android:name="android.permission.USE_BIOMETRIC" />

    <!--
      Android 11+ (API 30+) Package Visibility & Google Play Policy Justification:
      1. The <queries> block below declares explicit visibility for all launchable applications
         (ACTION_MAIN + CATEGORY_LAUNCHER), which is sufficient on Android 11+ to discover
         standard user-installed and launchable system applications without broad permissions.
      2. QUERY_ALL_PACKAGES is declared only as a documented fallback for dedicated device security
         / app-lock utilities that must also inspect non-launcher security-sensitive packages.
    -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
    </queries>

    <uses-permission
        android:name="android.permission.QUERY_ALL_PACKAGES"
        tools:ignore="QueryAllPackagesPermission" />

    <!-- Foreground App Usage Detection (Phase 4 Active - requires explicit user grant in Settings) -->
    <uses-permission
        android:name="android.permission.PACKAGE_USAGE_STATS"
        tools:ignore="ProtectedPermissions" />

    <!-- Lock Screen Overlay / Background Activity Launch Permission (Phase 4 Active) -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />

    <!-- Foreground Monitoring Service & Notification (Phase 4 Active) -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Boot Recovery for Persistent Monitoring (Phase 4 Active) -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <!--
      Optional Intruder Selfie Camera Permission (Phase 5 Active):
      Requested at runtime ONLY after explicit user consent in Intruder Detection settings.
      Front camera hardware is marked android:required="false" so devices without a front camera
      are fully supported and gracefully fall back to event-only intruder logging.
    -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature
        android:name="android.hardware.camera"
        android:required="false" />
    <uses-feature
        android:name="android.hardware.camera.front"
        android:required="false" />

    <application
        android:allowBackup="false"
        android:fullBackupContent="false"
        android:icon="@drawable/ic_launcher_foreground"
        android:roundIcon="@drawable/ic_launcher_foreground"
        android:label="NEXLOCK"
        android:supportsRtl="true"
        android:theme="@android:style/Theme.Material.NoActionBar">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Phase 4 Dedicated Lock Challenge Activity -->
        <activity
            android:name=".lockengine.AppLockActivity"
            android:exported="false"
            android:launchMode="singleTop"
            android:excludeFromRecents="true"
            android:noHistory="true"
            android:taskAffinity=""
            android:windowSoftInputMode="adjustResize" />

        <!-- Phase 4 Foreground Monitoring Service (Android 14+ specialUse compliant) -->
        <service
            android:name=".monitoring.AppLockMonitoringService"
            android:enabled="true"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="app_lock_foreground_protection_monitoring" />
        </service>

        <!-- Phase 4 Boot Recovery Receiver -->
        <receiver
            android:name=".monitoring.BootRecoveryReceiver"
            android:enabled="true"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>

        <!-- Phase 6 Smart Schedule Time & TimeZone Change Receiver -->
        <receiver
            android:name=".schedule.ScheduleTimeChangeReceiver"
            android:enabled="true"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.TIME_SET" />
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
                <action android:name="android.intent.action.DATE_CHANGED" />
                <action android:name="com.nexlock.security.action.EVALUATE_LOCK_SCHEDULES" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
